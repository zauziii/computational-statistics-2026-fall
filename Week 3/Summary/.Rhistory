library(ggplot2)
theme_set(
theme_classic(base_size = 12, base_family = "serif") +
theme(plot.title = element_text(hjust = 0.5, face = "bold"))
)
#| results: hold
obs_pearson <- cor(x, y, method = "pearson")
#| echo: false
#| warning: false
knitr::opts_chunk$set(
echo = TRUE,
warning = FALSE,
message = FALSE,
fig.width = 5.5,
fig.height = 3.8,
fig.align = "center",
