)
all(boot_min >= m_obs)          # TRUE, by construction: no resample can go below
mean(boot_min == m_obs)         # fraction exactly at m_n ~= 1 - (1-1/n)^n ~= 0.64
hist(boot_min - m_obs, breaks = 30, col = "#D6E6F5", border = "#2166AC",
main = "Bootstrap: m_n* - m_n", xlab = "")
hist(boot_min - m_obs, breaks = 30, col = "lightskyblue2", border = "steelblue",
main = "Bootstrap: m_n* - m_n", xlab = "")
true_min <- replicate(B, min(runif(n, theta, 1)))
par(mfrow = c(1, 2))
hist(boot_min - m_obs, breaks = 30, col = "#D6E6F5", border = "#2166AC",
main = "Bootstrap m_n* - m_n", xlab = "", xlim = c(0, 0.12))
hist(true_min - theta, breaks = 30, col = "#D6E6F5", border = "#2166AC",
main = "True m_n - theta", xlab = "", xlim = c(0, 0.12))
cmp <- rbind(
data.frame(diff = boot_min - m_obs, src = "Bootstrap  m_n* - m_n"),
data.frame(diff = true_min - theta, src = "True  m_n - theta")
)
ggplot(cmp, aes(x = diff, fill = src)) +
geom_histogram(aes(y = after_stat(density)), bins = 25,
color = "white", linewidth = 0.2, alpha = 0.9, show.legend = FALSE) +
scale_fill_manual(values = c("Bootstrap  m_n* - m_n" = "#4C4C4C",
"True  m_n - theta" = "#2166AC")) +
facet_wrap(~ src, nrow = 1) +
coord_cartesian(xlim = c(0, 0.12)) +
labs(x = "", y = "Density",
title = "Ordinary bootstrap vs true sampling distribution") +
theme_classic(base_size = 12, base_family = "serif") +
theme(plot.title = element_text(hjust = 0.5, face = "bold"),
panel.grid = element_blank(),
strip.background = element_blank(),
strip.text = element_text(face = "bold"))
